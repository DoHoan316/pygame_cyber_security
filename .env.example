# Local development defaults to SQLite. For deployment use Supabase PostgreSQL.
# Local: SQLite
DATABASE_URL=sqlite:///./cybersafe.db
# Supabase PostgreSQL example (replace with the connection string from Supabase):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001
# Optional: create the first Admin account on backend startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
